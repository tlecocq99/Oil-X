# Cache Configuration
# Uncomment and adjust these values to customize cache behavior

# Enable/disable caching entirely (default: true)
# CACHE_ENABLED=true

# Enable cache hit/miss logging (default: false)
# CACHE_LOGGING=true

# Cache TTL values in milliseconds
# Price data cache duration (default: 30000 = 30 seconds)
# CACHE_TTL_PRICE=30000

# Chart data cache duration (default: 120000 = 2 minutes)
# CACHE_TTL_CHART=120000

# Stats data cache duration (default: 60000 = 1 minute)
# CACHE_TTL_STATS=60000

# Trades data cache duration (default: 30000 = 30 seconds)
# CACHE_TTL_TRADES=30000

# Pool stats cache duration (default: 300000 = 5 minutes)
# CACHE_TTL_POOL_STATS=300000

# Cache cleanup interval (default: 60000 = 1 minute)
# CACHE_CLEANUP_INTERVAL=60000

# Your existing environment variables
# GT_NETWORK=solana
# GT_POOL=9h7GAGU8T75jdD2uHhFGEMHzCLLDXdgireWZho8jgnKp
# TOTAL_SUPPLY=100000000
# HOLDERS_COUNT=8432
# PORT=4000
