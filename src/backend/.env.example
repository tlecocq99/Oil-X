#############################################
# OilX Backend Environment Configuration
# Copy this file to .env and adjust as needed
#############################################

# GeckoTerminal defaults (can be overridden per-request via query params)
GT_NETWORK=solana
GT_POOL=9h7GAGU8T75jdD2uHhFGEMHzCLLDXdgireWZho8jgnKp

# Holder count placeholder until on-chain integration exists
HOLDERS_COUNT=884

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Server port
PORT=4000

# MongoDB configuration (falls back to in-memory if unreachable)
MONGO_URL=mongodb://127.0.0.1:27017/
MONGO_DB=oilx
MONGO_COLLECTION=price_ticks

# Add any secrets below (never commit the real .env file):
# API_KEY=
#############################################
